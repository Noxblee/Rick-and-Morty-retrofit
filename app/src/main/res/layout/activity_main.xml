<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    tools:context=".MainActivity">

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        tools:srcCompat="@drawable/ic_launcher_background" />

    <TextView
        android:id="@+id/nameTV"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Name"
        android:gravity="center"
        android:textFontWeight="800"
        android:textSize="48sp" />

    <TextView
        android:id="@+id/speciesTV"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="species, gender"
        android:textFontWeight="600"
        android:textSize="32sp"

        />

    <TextView
        android:id="@+id/statusTV"
        android:layout_width="wrap_content"
        android:textSize="32sp"
        android:layout_height="wrap_content"
        android:textFontWeight="600"
        android:text="status" />

    <Button
        android:id="@+id/opisB"
        android:textFontWeight="600"
        android:layout_marginLeft="40dp"
        android:layout_marginRight="40dp"
        android:textSize="24sp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/black"
        android:backgroundTint="@color/white"
        android:text="opis" />

    <EditText
        android:id="@+id/opisET"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ems="10"
        android:layout_margin="40dp"
        android:gravity="center"
        android:inputType="text"
        android:hint="Dodaj  swój opis / komentarz"
        android:textSize="24sp"
        android:visibility="gone"
        android:text="" />

    <Button
        android:id="@+id/nextB"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="32sp"
        android:gravity="bottom"
        android:layout_marginTop="40dp"
        android:text="Losuj następny" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="horizontal">

        <EditText
            android:layout_margin="20dp"
            android:id="@+id/idET"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ems="10"
            android:textSize="20sp"
            android:textFontWeight="700"
            android:gravity="center"
            android:hint="liczba całkowita (1 - 826)"
            android:inputType="number" />

        <Button
            android:id="@+id/szukajB"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:textSize="20sp"
            android:layout_marginTop="20dp"
            android:text="Szukaj ID" />

    </LinearLayout>


</LinearLayout>